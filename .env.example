# 环境配置（复制此文件为 .env 后修改）

# ===== 应用配置 =====
APP_NAME=enterprise-agent
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=DEBUG

# ===== 模型服务 =====
# 通义千问（主模型，兼容OpenAI协议）
QWEN_API_KEY=sk-ws-H.ELMEEME.23xv.MEYCIQDR1YqhOFaovyY56iN8DYWaeMPhqMpUX4BikyB9RuQcdQIhAKgbkgf13-6e2ZuhWfU4U82PQNnNpWXIZ2wzsjMy7ihQ
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_VISION_MODEL=qwen-vl-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3

# OpenAI（备用）
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# DeepSeek（推理增强备用）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-reasoner

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_secret_2024
POSTGRES_DB=agent_db

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== Neo4j =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret_2024

# ===== MinIO (S3兼容对象存储) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-storage
MINIO_USE_SSL=false

# ===== 安全配置 =====
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
